# Mapbox Public Access Token (Optional: A default fallback is included for instant demo)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Backend Database (Neon / PostgreSQL or SQLite)
DATABASE_URL=postgresql://user:password@ep-sample-pool.eu-central-1.aws.neon.tech/safety?sslmode=require

# Backend Security Keys (required: the backend refuses to start without them)
# Generate each one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECURITY_SECRET_KEY=change_me
ADMIN_API_KEY=change_me
